{
  "name": "company-brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant SaaS knowledge brain (fork-and-narrow of gbrain; see NOTICE + DECISIONS.md)",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "migrate": "bun run src/db/migrate.ts",
    "call": "bun run src/api/call.ts",
    "mcp": "bun run src/api/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.2"
  }
}
