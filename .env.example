# --- server ---
PORT=3000
NODE_ENV=development

# --- database: Supabase (managed Postgres + pgvector) ---
# From Supabase -> Project Settings -> Database -> Connection string.
#
# APP connection = the dedicated NON-BYPASSRLS role `cb_app` (created by `bun run migrate`),
# via the TRANSACTION pooler. Username form: cb_app.<project-ref>. Port 6543.
DATABASE_URL=postgres://cb_app.<project-ref>:<cb_app-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ADMIN connection = the `postgres` owner, via the SESSION pooler (port 5432 on the pooler host,
# username postgres.<project-ref>). Used ONLY by migrate.ts. The direct db.<ref>.supabase.co host
# is IPv6-only without the paid IPv4 add-on and fails to resolve on IPv4-only networks.
DATABASE_ADMIN_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Password migrate.ts assigns to the cb_app role — must equal <cb_app-password> in DATABASE_URL.
CB_APP_DB_PASSWORD=<cb_app-password>
# SSL: 'require' encrypts but does NOT verify the cert; use 'verify-full' (with the Supabase CA) in
# production. The pooler is transaction-mode (prepared statements off).
DB_SSL=require
DB_TRANSACTION_POOLER=1
# Optional app-pool sizing (defaults shown):
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT=20
# DB_CONNECT_TIMEOUT=30

# --- AI router (one door: src/ai/router.ts) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# provider:model form. ZDR is a per-workspace toggle, not a hard default (see DECISIONS D12).
#
# Chat model = OPEN decision, not yet chosen (DECISIONS D12.1). Founder ruled out Anthropic
# (too expensive) and OpenAI's chat models. Leave BLANK until decided together — router.ts
# throws a clear error instead of silently defaulting to either. Set both when ready:
CHAT_MODEL=
FRONTIER_MODEL=
# Embeddings are a separate, already-locked call (D13) — OpenAI embeddings are fine here; only
# the chat model is restricted. Gates the vector(N) column + HNSW index — do not change without
# a re-embed migration.
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIM=1536

# --- auth (Google OIDC, wired at M2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_SECRET=
